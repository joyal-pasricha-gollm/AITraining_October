APP_NAME=ReclaimAI API
APP_VERSION=1.0.0
APP_ENVIRONMENT=development
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=reclaimai_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your_postgres_password
FRONTEND_URL=http://localhost:5173
JWT_SECRET_KEY=generate_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_NAME=ReclaimAI Administrator
ADMIN_EMAIL=admin@reclaimai.local
ADMIN_PASSWORD=replace_with_a_secure_password
